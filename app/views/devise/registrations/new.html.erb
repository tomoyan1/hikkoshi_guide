<div class="auth-container">
  <div class="auth-card">
    <div class="auth-title"><h2>新規登録</h2></div>

    
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="devise-field">
        <p><%= f.label :email, "メールアドレス" %></p>
        <p><%= f.email_field :email, class: "devise-input", autofocus: true, autocomplete: "email" %></p>
      </div>
      <%if @sns_id.present? %>
        <%= hidden_field_tag :sns_auth, true %>
      <% else %>
      <div class="devise-field">
        <p><%= f.label :password, "パスワード" %></p>
        <% if @minimum_password_length %>
          <p><em>(<%= @minimum_password_length %>文字以上)</em></p>
        <% end %>
        <p><%= f.password_field :password, class: "devise-input", autocomplete: "new-password" %></p>
      </div>

      <div class="devise-field">
        <p><%= f.label :password_confirmation, "パスワード（確認用）" %></p>
        <p><%= f.password_field :password_confirmation, class: "devise-input", autocomplete: "new-password" %></p>
      </div>
     <% end %>
      <div class="devise-field">
        <p><%= f.label :name, "名前" %></p>
        <p><%= f.text_field :name, class: "devise-input" %></p>
      </div>

      <div class="devise-field">
        <p><%= f.label :old_zipcode, "旧居の郵便番号(退去する家)" %></p>
        <p><%= f.text_field :old_zipcode, class: "devise-input", placeholder: "例: 123-4567" %></p>
      </div>

      <div class="devise-field">
        <p><%= f.label :old_address, "旧居の住所(退去する家)" %></p>
        <p><%= f.text_field :old_address, class: "devise-input" %></p>
      </div>

      <div class="devise-field">
        <p><%= f.label :new_zipcode, "新居の郵便番号（入居する家）" %></p>
        <p><%= f.text_field :new_zipcode, class: "devise-input", placeholder: "例: 123-4567" %></p>
      </div>

      <div class="devise-field">
        <p><%= f.label :new_address, "新居の住所（入居する家）" %></p>
        <p><%= f.text_field :new_address, class: "devise-input" %></p>
      </div>

      <div class="devise-field">
        <p><%= f.label :move_out_date, "退去予定日" %></p>
        <p><%= f.date_field :move_out_date, class: "devise-input" %></p>
      </div>

      <div class="devise-field">
        <p><%= f.label :move_in_date, "入居予定日" %></p>
        <p><%= f.date_field :move_in_date, class: "devise-input" %></p>
      </div>

      <div class="devise-actions">
        <%= f.submit "新規登録", class: "devise-submit" %>
      </div>
      <div class="other-actions">
      <%= button_to "Googleで登録", user_google_oauth2_omniauth_authorize_path,class: "google-submit", data: { turbo: false } %>
      <%= render "devise/shared/links" %>
    <% end %>
      </div>
   
  </div> <%# auth-card  %>
</div>