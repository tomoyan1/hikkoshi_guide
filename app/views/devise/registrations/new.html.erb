<div class="field">
    <p><%= f.label :メールアドレス %></p>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email" %></p>
  </div>

  <div class="field">
    <p><%= f.label :パスワード%></p>
    <% if @minimum_password_length %>
      <p><em>(<%= @minimum_password_length %>文字以上)</em></p>
    <% end %>
    <p><%= f.password_field :password, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :パスワード（確認用） %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :名前 %></p>
    <p><%= f.text_field :name %></p>
  </div>

  <div class="field">
    <p><%= f.label :old_address, "旧居の住所（退去する家）" %></p>
    <p><%= f.text_field :old_address %></p>
  </div>

  <div class="field">
    <p><%= f.label :new_address, "新居の住所（入居する家）" %></p>
    <p><%= f.text_field :new_address %></p>
  </div>

  <div class="field">
    <p><%= f.label :move_out_date, "退去予定日" %></p>
    <p><%= f.date_field :move_out_date %></p>
  </div>

  <div class="field">
    <p><%= f.label :move_in_date, "入居予定日" %></p>
    <p><%= f.date_field :move_in_date %></p>
  </div>
  <div class="actions">
    <%= f.submit "Sign up" %>
  </div>
<% end %>