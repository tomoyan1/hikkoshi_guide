<div class="task-cards">
  <% @tasks.each do |task| %>
    <% if task.task_type == 0 && task.status_id != 3 %> <%# 新居のタスク %>
    
      <div class="task-card">
        <div class="task-card__name">
          <h3><%= task.name %></h3>
        </div>
        
        <div class="task-card__date">
          期限：<%= task.due_date %> (あと <%= (task.due_date - Date.current).to_i %>日)
        </div>

        <%# メモがある時だけ表示 %>
        <% if task.task_address.present? %>
          <div class="task-card__memo">
            <%= auto_link(truncate(task.task_address, length: 50), html: { target: '_blank', rel: 'noopener' }) %>
          </div>
        <% end %>
          <% if task.status.present? %>
         <div class="task-card__status">
          <%= task.status.name %>
         </div>
       <% end %>
        <% if task.category.present? %>
         <div class="task-card__category">
          <%= task.category.name %>
         </div>
         <%= link_to "詳細を見る",task_path(task), class: "task-card-link"  %>
       <% end %>
        
      </div> 
      <% end %>
    
  <% end %>
</div>