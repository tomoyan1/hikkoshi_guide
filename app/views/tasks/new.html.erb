
<h2>
  <% if @task.task_type == 0 %>
    旧居（退去）のタスクを追加
  <% elsif @task.task_type == 1 %>
    新居（入居）のタスクを追加
  <% else %>
    タスクを追加
  <% end %>
</h2>

  <%= form_with(model: @task, local: true) do |f| %>
    
    <%= f.hidden_field :task_type %>
  <div class = "form-list">
    <%= f.label :name, "タイトル" %>
    <%= f.text_field :name, placeholder: "区役所に転居届を提出する", required: true %>
  </div>
  <div class = "form-list">
    <%= f.label :category_id, "カテゴリ" %>
    <%= f.collection_select(:category_id, Category.all, :id, :name) %>
  </div>
  <div class = "form-list">
    <%= f.label :due_date, "期限(予定日)" %>
    <%= f.date_field :due_date %>
  </div>
    <div class="field">
      <%= f.label :task_address, "場所/連絡先など（任意）" %>
     <%= f.text_field :task_address, placeholder: "例：〇〇区役所/https~~.jp" %>
    </div>
    <div class="field">
      <%= f.label :image, "写真を登録" %> 
      <%= f.file_field :image %>
       <div class="tasks-field">
       <%= f.label :status, "状態" %> 
      <%= f.collection_select(:status_id,Status.all, :id, :name)  %>
    </div>
  <%= f.submit "作成" %>
<% end %>
</div>

<%= link_to "戻る", root_path %><br>