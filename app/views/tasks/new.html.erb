<div class="form-container">
  <div class="form-card">
    <h2 class="form-title">
      <% if @task.task_type == 0 %>
        旧居（退去）のタスクを追加
      <% elsif @task.task_type == 1 %>
        新居（入居）のタスクを追加
      <% else %>
        タスクを追加
      <% end %>
    </h2>

    <%= form_with(model: @task, id: 'task_form', local: true) do |f| %>
      <%= render 'shared/error_messages', model: f.object %>
      <%= f.hidden_field :task_type %>

      <div class="form-list">
        <%= f.label :name, "タイトル" %>
        <%= f.text_field :name, placeholder: "区役所に転居届を提出する",class: "form-input",  required: true %>
      </div>

      <div class="form-list">
        <%= f.label :category_id, "カテゴリ" %>
        <%= f.collection_select(:category_id, Category.all, :id, :name) %>
      </div>

      <div class="form-list">
        <%= f.label :due_date, "期限(予定日)" %>
        <%= f.date_field :due_date ,class: "form-input" %>
      </div>

      <div class="form-list">
        <%= f.label :task_address, "場所/連絡先など（任意）" %>
        <%= f.text_area :task_address, placeholder: "例：〇〇区役所/https~~.jp",class: "form-input" %>
      </div>

      <div class="form-list image-field">
        <%= f.label :image, "写真を登録" %>
        <div class="image-input-group">
          <img id="preview" class="task-thumbnail">
          <%= f.file_field :image, id: 'task_image' %>
        </div>
      </div>

      <div class="form-list">
        <%= f.label :status, "状態" %>
        <%= f.collection_select(:status_id, Status.all, :id, :name) %>
      </div>

      <div class="form-actions">
        <%= f.submit "作成", class: "submit-button" %>
      </div>
    <% end %>

    <div class="back-link">
      <%= link_to "戻る", root_path %>
    </div>
  </div>
</div>