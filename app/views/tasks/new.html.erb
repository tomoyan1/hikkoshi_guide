<h1>タスクを作成</h1>
<p>選んでね</p>

 <div class = "task-form">
<%= form_with model: @task, local: true do |f| %>
  <div class = "form-list">
    <%= f.label :title, "タイトル" %>
    <%= f.text_field :title %>
  </div>
  <div class = "form-list">
    <%= f.label :description, "説明" %>
    <%= f.text_area :description %>
  </div>
  <%= f.submit "作成" %>
<% end %>
</div>

<%= link_to "戻る", root_path %><br>