<% if user_signed_in? %>
  <div class="move-out">
    <div class="home-status_blue">
      
      
      <div class="home-status-content">
        <div class="status-date">
          <div class="task-type">旧居</div>
          <div class="move-in--date">退去日：<%= current_user.move_out_date %></div>
          <% if current_user.move_out_date.present? %>
            <div class="date-countdown">（退去まであと：<%= (current_user.move_out_date - Date.current).to_i %>日）</div>
          <% end %>
        </div>

        <div class="address">
          <div class="post-address">〒<%= current_user.old_zipcode %></div>
          <div class="home-address">住所：<%= current_user.old_address %></div>
          <div class="home-address_copy">
            <button class="address-copy-button" data-address="<%= current_user.old_address %>">住所をコピーする</button>
          </div>
        </div>

        <div class="button-group">
          <div class="add-task">
            <%= link_to new_task_path(task_type: 0) do %>
            <%= image_tag 'plus.png', size: "20x20" %>
            旧居のタスクを追加
            <% end %>
            
          </div>
        </div>
      </div>

      <div class="add-task add-task-template">
        <%= link_to 'タスクをまとめて追加する', select_template_tasks_path, class: "btn-template" %>
      </div> 
    </div>
  </div>
  <%= render partial: "out", locals: {task: @tasks} %>

  <div class="move-in">
    <div class="home-status_orange">
      
      
      <div class="home-status-content">
        <div class="status-date">
          <div class="task-type">新居</div>
          <div class="move-in--date">入居日：<%= current_user.move_in_date %></div>
          <% if current_user.move_in_date.present? %>
            <div class="date-countdown">（入居まであと：<%= (current_user.move_in_date - Date.current).to_i %>日）</div>
          <% end %>
        </div>

        <div class="address">
          <div class="post-address">〒 <%= current_user.new_zipcode %></div>
          <div class="home-address">住所：<%= current_user.new_address %></div>
          <div class="home-address_copy">
            <button class="address-copy-button" data-address="<%= current_user.new_address %>">住所をコピーする</button>
          </div>
        </div>

        <div class="button-group">
          <div class="add-task">
            
            <%= link_to new_task_path(task_type: 1) do%>
              <%= image_tag 'plus.png', size: "20x20" %>
              新居のタスクを追加
            <% end %>
          </div>
        </div>
      </div> 
    </div> 
    <%= render partial: "in", locals: {task: @tasks} %>
  </div>
<% end %>