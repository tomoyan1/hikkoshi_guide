<div class="task-cards">
  <% @tasks.each do |task| %>
    <% if task.task_type == 1 %> <%# 新居のタスク %>
    <%= link_to task_path(task), class: "task-card-link" do %>
      <div class="task-card">
        <div class="task-card__name">
          <h3><%= task.name %></h3>
        </div>
        
        <div class="task-card__date">
          期限：<%= task.due_date %> (あと <%= (task.due_date - Date.current).to_i %>日)
        </div>

        <%# メモがある時だけ表示 %>
        <% if task.task_address.present? %>
          <div class="task-card__memo">
            <%= truncate(task.task_address, length: 50) %>
          </div>
        <% end %>

      </div> 
      <% end %>
    <% end %>
  <% end %>
</div>