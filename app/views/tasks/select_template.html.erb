<div class="template-container">
  <div class="template-card">
    <h2 class="template-title">追加するタスクを選択</h2>
    <p class="template-description">必要なタスクにチェックを入れたまま、追加ボタンを押してください。</p>

    <%= form_with url: bulk_create_tasks_path, method: :post, local: true do |f| %>
      <h3 class="section-title">旧居の必須手続き</h3>
      <div class="card-grid">
        <% @old_tasks.each do |task| %>
          <label class="task-select-card">
            <div class="checkbox-wrapper">
              <%= check_box_tag "task_ids[]", task[:id], false %>
            </div>
            <div class="card-content">
              <span class="task-name"><%= task[:name] %></span>
              <span class="task-timing">(引越しの <%= task[:days_offset].abs %> 日前)</span>
            </div>
          </label>
        <% end %>
      </div>

      <h3 class="section-title">新居の必須手続き</h3>
      <div class="card-grid">
        <% @new_tasks.each do |task| %>
          <label class="task-select-card">
            <div class="checkbox-wrapper">
              <%= check_box_tag "task_ids[]", task[:id], false %>
            </div>
            <div class="card-content">
              <span class="task-name"><%= task[:name] %></span>
            </div>
          </label>
        <% end %>
      </div>

      <div class="template-actions">
        <%= f.submit "選択したタスクを追加する", class: "btn-primary" %>
        <%= link_to "キャンセル", root_path, class: "btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>